{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict qualified OpenArt CLI video inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "model",
    "mode",
    "duration",
    "aspect_ratio",
    "resolution",
    "output_path",
    "governance"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "integer",
      "minimum": 1
    },
    "aspect_ratio": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "project_dir": {
      "type": "string"
    },
    "governance": {
      "type": "object",
      "required": [
        "scope_id",
        "shot_id"
      ],
      "additionalProperties": false,
      "properties": {
        "scope_id": {
          "type": "string"
        },
        "shot_id": {
          "type": "string"
        }
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "image_path": {
      "type": "string",
      "minLength": 1
    },
    "image_upload_id": {
      "type": "string",
      "minLength": 1
    },
    "native_dry_run_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "native_dry_run_receipt_sha256": {
      "type": "string",
      "minLength": 1
    },
    "compiled_request_id": {
      "type": "string",
      "minLength": 1
    },
    "preparation_review_id": {
      "type": "string",
      "minLength": 1
    },
    "credit_authorization_id": {
      "type": "string"
    },
    "credit_quote_id": {
      "type": "string"
    },
    "credit_qualification_sha256": {
      "type": "string"
    },
    "unknown_cost_authorization_id": {
      "type": "string",
      "minLength": 1,
      "description": "Retained explicit unknown-cost authorization; requires matching unknown_cost_evidence_id. Unknown never means zero, a USD estimate, or a cost ceiling."
    },
    "unknown_cost_evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "dependentRequired": {
    "unknown_cost_authorization_id": [
      "unknown_cost_evidence_id"
    ],
    "unknown_cost_evidence_id": [
      "unknown_cost_authorization_id"
    ]
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "unknown_cost_authorization_id"
            ]
          },
          {
            "required": [
              "unknown_cost_evidence_id"
            ]
          }
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "credit_authorization_id"
              ]
            },
            {
              "required": [
                "credit_quote_id"
              ]
            },
            {
              "required": [
                "credit_qualification_sha256"
              ]
            }
          ]
        }
      }
    }
  ]
}
