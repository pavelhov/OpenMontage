{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Explicit retained OpenArt credit authorization",
  "properties": {
    "version": {
      "const": "1"
    },
    "status": {
      "const": "approved"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "story_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "allowance_id": {
      "type": "string",
      "minLength": 1
    },
    "allowance": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "ceiling": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "enum": [
        "generation",
        "result_contract_qualification"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "index",
          "request_sha256",
          "native_sha256",
          "profile_sha256",
          "quote_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "native_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "profile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "required": [
    "version",
    "status",
    "approved_by",
    "project_root",
    "project_id",
    "story_revision",
    "scope_id",
    "shot_id",
    "account_id_sha256",
    "workspace",
    "allowance_id",
    "allowance",
    "ceiling",
    "count",
    "purpose",
    "evidence",
    "occurrences"
  ],
  "description": "Exact credit terms must match current approved production scope credit_authorization_sha256; retained evidence is the trusted local human capture boundary, not caller booleans."
}
