{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Opaque public provider credit quote summary; raw receipts remain private",
  "properties": {
    "version": {
      "const": "1"
    },
    "credit_state": {
      "const": "retained_quote"
    },
    "quote_id": {
      "type": "string",
      "minLength": 1
    },
    "quote_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "quantum": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "account_id_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualification_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "credit_state",
    "quote_id",
    "quote_sha256",
    "proof_sha256",
    "amount",
    "quantum",
    "account_id_sha256",
    "workspace_sha256",
    "qualification_sha256",
    "contract_sha256"
  ]
}
